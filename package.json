{
  "name": "dickytwiste-portal",
  "version": "0.6.0",
  "description": "Dickytwiste 本地门户 —— 多标签桌面壳应用，收纳 dickytwiste.top 全部 web 功能",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "publish": "electron-builder --win --publish always"
  },
  "author": "Helios",
  "license": "MIT",
  "build": {
    "appId": "com.helios.dickytwiste-portal",
    "productName": "Dickytwiste Portal",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true
    },
    "publish": {
      "provider": "github",
      "owner": "XRLZX8",
      "repo": "dickytwiste-portal",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^25.1.0"
  }
}