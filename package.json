{
  "name": "dickytwiste-portal",
  "version": "0.4.0",
  "description": "Dickytwiste \u672c\u5730\u95e8\u6237 \u2014\u2014 \u591a\u6807\u7b7e\u684c\u9762\u58f3\u5e94\u7528\uff0c\u6536\u7eb3 dickytwiste.top \u5168\u90e8 web \u529f\u80fd",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "publish": "electron-builder --win --publish always"
  },
  "author": "Helios",
  "license": "MIT",
  "build": {
    "appId": "com.helios.dickytwiste-portal",
    "productName": "Dickytwiste Portal",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "XRLZX8",
      "repo": "dickytwiste-portal",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^25.1.0"
  }
}